# ==============================================================================
# WHERE IS MY BUS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Multi-Institution Transportation Management SaaS Platform
# ==============================================================================

# 1. SERVER CONFIGURATION
PORT=3001
NODE_ENV=production

# 2. APPLICATION FRONTEND URL (For CORS & Invitation URLs)
FRONTEND_URL=https://where-is-my-bus-639k.onrender.com

# 3. SUPABASE POSTGRESQL & SERVICE ROLE CREDENTIALS
# Required for database connections and backend operations
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-do-not-expose-to-frontend

# 4. JSON WEB TOKEN (JWT) SECURITY
# Minimum 32 cryptographically random characters
JWT_SECRET=generate-a-secure-random-32-char-string-for-jwt-signing-2026-prod

# 5. MULTI-TENANT INSTITUTION ACCESS CODE CRYPTOGRAPHY
# Server-side HMAC-SHA-256 secret key used for hashing institution access codes
INSTITUTION_CODE_HMAC_KEY=generate-a-secure-random-secret-key-for-hmac-sha256-access-codes-min-32-chars
INSTITUTION_CODE_HMAC_KEY_VERSION=v1

# 6. PLATFORM DEVELOPER / SUPER ADMIN BOOTSTRAP CREDENTIALS
# Used for initial super admin access if database platform_admins table has not yet been seeded
SUPER_ADMIN_BOOTSTRAP_USER=superadmin
SUPER_ADMIN_BOOTSTRAP_PASS=ChangeThisSecurePasswordBeforeProduction2026!

# 7. GOOGLE OAUTH 2.0 (GIS) CLIENT IDENTIFIER
# Required for student/parent/teacher Google Sign-In
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# 8. OPENROUTE SERVICE (ORS) API KEY (Optional for ETA caching)
ORS_API_KEY=your-openrouteservice-api-key-here
ETA_POLL_INTERVAL_MS=45000
VIEWER_TTL_MS=60000

